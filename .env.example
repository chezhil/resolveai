# Brain: auto picks the LLM when a key is present, else the offline planner. Options: auto | llm | planner
BRAIN=auto

# Primary LLM — Groq (OpenAI-compatible tool calling). Model auto-picked from /models if unset.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Fallback LLM — Gemini via its OpenAI-compatible endpoint. Newest stable Flash auto-picked if unset.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Sarvam AI for Indic speech (voice-note ASR + TTS replies)
SARVAM_API_KEY=
# SARVAM_ASR_MODEL=saarika:v2.5
# SARVAM_TTS_MODEL=bulbul:v2

# Delay between trace steps in the live console (ms). Evals always use 0.
PACING_MS=450
# API port in dev (the console proxies /api here). Production uses PORT.
API_PORT=8787

# Optional: real WhatsApp via Twilio. Webhook: POST {PUBLIC_URL}/api/channels/whatsapp/twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_SANDBOX_JOIN=join <your-sandbox-code>
# PUBLIC_URL=https://your-deploy.example.com
# WHATSAPP_ROOM=whatsapp
# WHATSAPP_MERCHANT_ID=M1001

# Case + audit archive (SQLite). Mount a volume here in production to keep it across deploys.
# DB_PATH=data/resolveai.db

# Security keys. Random per process if unset; set them so tokens and anchors survive restarts.
# ACTION_SIGNING_KEY=
# ANCHOR_SIGNING_KEY=
# Publish audit anchors to a GitHub Gist (public revision history)
# GITHUB_TOKEN=
# ANCHOR_GIST_ID=
# Per-IP write limit on the public API
# WRITE_RATE_PER_MIN=120

# Approver PINs for L2 approvals and the two-person rule (P13). Use 6+ digits.
# When set, the approver is identified by the PIN on the server; unset = simulated identity.
# APPROVER_OPS_PIN=
# APPROVER_RISK_PIN=
# APPROVAL_RATE_PER_MIN=10
# Proxy hops to trust for client IPs (Railway/Render: 1), and open live streams per IP
# TRUST_PROXY_HOPS=1
# MAX_STREAMS_PER_IP=30
